<component xmlns="http://jetbrains.org/intellij/schema/application-info">
  <!-- Здесь ДВА разных числа, и это не небрежность.
       major/minor обязаны кодировать линию платформы: сборщик сверяет их с номером снапшота
       (ApplicationInfoPropertiesImpl.computeAppInfoXml) и падает, если «2026»+«3» не сворачивается
       в «263». Проверено сборкой: major="0" minor="3" её роняет.
       full — то, что человек видит в «О программе» и называет в issue. Формат MessageFormat, и
       строка без подстановок означает буквально её саму, поэтому здесь стоит версия ПРОДУКТА.
       Это же число сверяется с тегом при выпуске (releaseStamp.sh). -->
  <version major="2026" minor="3" micro="0" full="0.4.0" eap="false"/>
  <company name="VibeBrains" shortName="VibeBrains" url="https://github.com/VibeBrains"/>
  <build number="VI-__BUILD__" date="__BUILD_DATE__" majorReleaseDate="20260823"/>
  <icon svg="/vibeidea.svg" svg-small="/vibeidea_16.svg"/>
  <icon-eap svg="/vibeidea-eap.svg" svg-small="/vibeidea-eap_16.svg"/>
  <names product="VibeIDEA" fullname="VibeIDEA" script="idea" motto="Ты видишь всё — и управляешь всем"/>

  <essential-plugin>com.intellij.java</essential-plugin>
  <essential-plugin>com.intellij.java.ide</essential-plugin>
  <essential-plugin>com.intellij.modules.json</essential-plugin>
</component>
