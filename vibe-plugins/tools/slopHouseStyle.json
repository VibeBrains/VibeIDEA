// ─────────────────────────────────────────────────────────────────────────────
//  slopHouseStyle.json — правки каталога нейрослопа для текстов самого репозитория:
//  документации docs/vibe, README.md и заметок к релизу. Формат тот же, что у .vibe/slop.json
//  (docs/vibe/manuals/slopSpec.md). Читают гейты checkVibeSlop.sh и checkVibeReleaseNotes.sh.
//
//  Отключено то, что в нашем доме норма, а не примета:
//   • F5 — жирный посреди строки: так у нас пишутся ярлыки и суть («**Решением владельца…**»).
//   • F6 — заголовок над одной-двумя фразами: запись дорожной карты или базы знаний бывает
//     короткой по делу, а не по привычке.
//   • R2 — короткие предложения подряд: правило «одна мысль — одна строка» даёт их само.
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 1,
  "disable": ["F5", "F6", "R2"],
  "allow": [],
  "rules": []
}
