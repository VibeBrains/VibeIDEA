load("@community//build:tests-options.bzl", "jps_test")
load("@rules_jvm//:jvm.bzl", "jvm_library")

jvm_library(
    name = "vibe-agent",
    srcs = glob(
        [
            "src/**/*.kt",
            "src/**/*.java",
        ],
        allow_empty = True,
    ),
    module_name = "intellij.vibe.agent",
    resource_strip_prefix = "resources",
    resources = glob(
        ["resources/**/*"],
        # vibeDefaults is a git submodule (VibeBrains); its gitlink file is not a resource.
        exclude = ["resources/vibeDefaults/.git"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        # do not sort,
        "@lib//:kotlin-stdlib",
        "@lib//:kotlinx-serialization-json",
        "@lib//:kotlinx-serialization-core",
        "//platform/core-api:core",
        "//platform/core-impl",
        "//platform/projectModel-api:projectModel",
        "//platform/util",
        "//platform/extensions",
        "//platform/platform-api:ide",
        "//platform/ide-core",
        "//platform/util:util-ui",
        "//platform/platform-util-io:ide-util-io",
        "//platform/analysis-api:analysis",
        "//platform/core-ui",
        "//platform/ui.jcef",
        "//libraries/jcef",
        "//platform/credential-store",
        "//platform/platform-impl/codeinsight-inline:ide-codeinsight-inline",
        "//libraries/kotlinx/coroutines/core",
        "//platform/editor-ui-api:editor-ui",
        "//platform/indexing-api:indexing",
        "//uast/uast-common:uast",
        "//java/java-psi-api:psi",
        "//platform/diff-api:diff",
        "//platform/lang-impl",
        "//platform/lang-api:lang",
        "//platform/platform-impl:ide-impl",
        "//platform/util/text-matching",
    ],
)

jvm_library(
    name = "vibe-agent_test_lib",
    testonly = True,
    srcs = glob(
        ["testSrc/**/*.kt"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
    associates = [":vibe-agent"],
    deps = [
        # do not sort,
        "@lib//:kotlin-stdlib",
        "@lib//:kotlinx-serialization-json",
        "@lib//:kotlinx-serialization-core",
        "@lib//:kotlin-test",
        "@lib//:kotlin-test-junit5",
        "//libraries/junit5",
        "//libraries/junit5:junit5_test_lib",
    ],
    runtime_deps = [
        # do not sort,
        ":vibe-agent",
    ],
)

jps_test(
    name = "vibe-agent_test",
    runtime_deps = [":vibe-agent_test_lib"],
)

exports_files(
    [
        "intellij.vibe.agent.iml",
        "resources/META-INF/plugin.xml",
    ],
    visibility = ["//visibility:public"],
)
