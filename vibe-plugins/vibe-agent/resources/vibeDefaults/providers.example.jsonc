// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/providers.json — свои LLM-провайдеры для прямого чата (формат VibeIDE)
//
//  Это ПРИМЕР. Чтобы включить: скопируйте в .vibe/providers.json (строгий JSON,
//  без комментариев). Проектный файл ДОПОЛНЯЕТ глобальный ~/.vibe/providers.json
//  (совпавший id — проектный сильнее). Ключи в файле не живут никогда:
//  apiKeyEnv (из .vibe/.env или окружения) либо apiKeyRef (хранилище ОС, поле
//  в Settings → Tools → VibeIDEA → Провайдеры).
//  Полная спека: docs/vibe/manuals/providersSpec.md.
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 1,
  "providers": [
    {
      "id": "ollama",
      "name": "Ollama (локально)",
      "protocol": "openai",              // openai (дефолт) | anthropic | gemini
      "baseURL": "http://localhost:11434/v1",
      "apiKeyEnv": "OLLAMA_API_KEY",     // локальным обычно не нужен — можно убрать
      "active": true,
      "models": {
        "fetch": true,                   // авто-каталог с <baseURL>/models
        "static": [
          { "id": "qwen3:14b", "name": "Qwen3 14B", "default": true, "contextWindow": 131072 }
        ]
      }
    }
  ]
}
