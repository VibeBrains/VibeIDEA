// ─────────────────────────────────────────────────────────────────────────────
//  .vibe/pipelines.json — цепочки шагов-ролей (формат VibeIDE)
//
//  Это ПРИМЕР. Чтобы включить: скопируйте в .vibe/pipelines.json (строгий JSON,
//  без комментариев). Запуск — иконка «Пайплайн…» в композере чата.
//  Каждый шаг — отдельный ход агента со своей ролью; провал шага помечает
//  следующие как «пропущен» (если у них нет continueOnFailure).
//  Полная спека: docs/vibe/manuals/pipelinesSpec.md.
// ─────────────────────────────────────────────────────────────────────────────
{
  "version": 1,
  "pipelines": [
    {
      "id": "feature",                    // обязателен, уникален; по нему запуск
      "name": "Фича под ключ",
      "description": "Спроектировать, реализовать, проверить",
      "steps": [                          // 1..20 шагов, порядок = порядок выполнения
        { "role": "planner",       "task": "Разбей задачу на шаги и запиши план в docs/plan.md" },
        { "role": "backend-dev",   "task": "Реализуй по плану", "acceptance": "Проект собирается" },
        { "role": "code-reviewer", "task": "Найди дефекты в изменениях", "ignorePreviousArtifacts": true }
      ]
    }
  ]
}
