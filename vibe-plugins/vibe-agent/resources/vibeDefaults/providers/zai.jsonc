// Z.AI (Zhipu / GLM) — OpenAI-совместимый API.
// Ключ: ZAI_API_KEY=<ключ> в .vibe/.env (взять: z.ai/manage-apikey/apikey-list, дока: docs.z.ai).
//
// ДВА РАЗНЫХ ЭНДПОИНТА — выберите тот, за который вы платите:
//   • /api/coding/paas/v4 — GLM Coding Plan (подписка). Ключ из раздела
//     «Model & Personal Coding Plan» работает ТОЛЬКО здесь. Это дефолт ниже.
//   • /api/paas/v4        — оплата за токены (pay-as-you-go): замените baseURL.
//
// Симптом перепутанного эндпоинта — не «неверный ключ», а HTTP 429 с кодом 1113
// «Insufficient balance or no resource package. Please recharge»: подписочный ключ ушёл
// на пер-токенный счёт, где денег нет (проверено живьём 06.08.2026).
{
  "version": 1,
  "providers": [
    {
      "id": "zai",
      "name": "Z.AI (GLM)",
      "active": true,
      "protocol": "openai",
      "baseURL": "https://api.z.ai/api/coding/paas/v4",
      "auth": "bearer",
      "apiKeyEnv": "ZAI_API_KEY",
      "order": 40,
      "models": { "fetch": true } // каталог у z.ai живёт на <baseURL>/models — ровно туда и ходим
    }
  ]
}
