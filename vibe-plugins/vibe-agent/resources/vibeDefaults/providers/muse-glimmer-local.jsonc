// Muse Glimmer 30B (Meta, Apache 2.0) — открытая модель для локальных агентов:
// 30B, контекст 131K+, вход текст и изображения. Ключ не нужен — всё локально.
//
// ⚠️ ГЛАВНОЕ — ФОРМАТ ВЫЗОВА ИНСТРУМЕНТОВ. Glimmer отдаёт вызовы инструментов НЕ в JSON,
// а XML-подобной разметкой ATEM, и размышление шлёт отдельным каналом. Из IDE это выглядит
// так, будто модель «не умеет инструменты»: вызовы приходят обычным текстом. Правкой этого
// файла симптом НЕ лечится — разбор делает сервер, запускайте его с ОБОИМИ парсерами:
//
//   vllm serve meta-models/Muse-Glimmer-30B \
//     --tool-call-parser muse_glimmer \
//     --reasoning-parser muse_glimmer
//
// Парсеры работают в паре: reasoning-парсер ставит skip_special_tokens=False, без него
// маркеры срезаются до разбора и оба канала перемешиваются с ответом.
//
// ПАМЯТЬ: Q4-сборка — 17–20 ГБ на диске плюс KV-кэш; на 16 ГБ не запустится, 24 ГБ хватает
// для Q4 на умеренном контексте, полная точность — 55+ ГБ.
// ПРИМЕНЕНИЕ: сильна в оркестрации и рассуждении, слабее в терминале — разумны read-only
// роли (разведчик, ревьюер, чтение кода).
//
// Рекомендованные вендором параметры сэмплинга (temperature 1.0, topP 0.95) фиксируются
// кастомной моделью — пример в static ниже. topK из карточки модели не переносим:
// openai-протокол его не отправляет, поле молча пропало бы.
{
  "version": 1,
  "providers": [
    // Вариант 1 — Ollama (сборка -dflash включает спекулятивное декодирование DFlash).
    {
      "id": "muse-glimmer-ollama",
      "name": "Muse Glimmer 30B (Ollama, локально)",
      "active": false,
      "protocol": "openai",
      "baseURL": "http://localhost:11434/v1",
      "auth": "none",
      "order": 95,
      "models": {
        "fetch": true
        // "static": [
        //   {
        //     "id": "muse-glimmer:30b-q4_K_M-dflash",
        //     "name": "Muse Glimmer 30B (Q4, DFlash)",
        //     "default": true,
        //     "contextWindow": 131072,
        //     "temperature": 1.0, "topP": 0.95 // рекомендация вендора, не наши предпочтения
        //   }
        // ]
      }
    },

    // Вариант 2 — vLLM. Включайте только после того, как сервер поднят с парсерами из шапки.
    {
      "id": "muse-glimmer-vllm",
      "name": "Muse Glimmer 30B (vLLM, локально)",
      "active": false,
      "protocol": "openai",
      "baseURL": "http://localhost:8000/v1",
      "auth": "none",
      "order": 96,
      "models": { "fetch": true }
    }
  ]
}
