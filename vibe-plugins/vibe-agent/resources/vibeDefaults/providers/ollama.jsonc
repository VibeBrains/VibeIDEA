// Ollama — локальные модели без ключа. Включите, если крутите модели локально:
// провайдер покажет всё, что уже скачано (`ollama pull <модель>` → список подтянется
// с локального каталога). Ключ не нужен, наружу ничего не уходит.
{
  "version": 1,
  "providers": [
    {
      "id": "ollama",
      "name": "Ollama (локально)",
      "active": false,
      "protocol": "openai",
      "baseURL": "http://localhost:11434/v1",
      "auth": "none",
      "order": 100,
      "models": { "fetch": true }
    }
  ]
}
