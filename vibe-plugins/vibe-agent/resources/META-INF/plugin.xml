<idea-plugin>
  <id>com.vibe.agent</id>
  <name>Vibe Agent</name>
  <vendor>VibeBrains</vendor>
  <description><![CDATA[
    Agent harness for VibeIDEA: a native Agent Client Protocol (ACP) client.
    Connects local coding agents (Claude Code via claude-agent-acp, Codex, Gemini CLI,
    goose and 60+ others from the ACP registry) to the IDE: streamed sessions,
    permission-gated tool calls, IDE-mapped file reads/writes.
    Compatible with the ~/.jetbrains/acp.json agent registry format.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <!-- Схемы .vibe/*.json: автодополнение и проверка в редакторе вместо разбора по логам. -->
  <depends optional="true" config-file="vibe-json-schemas.xml">com.intellij.modules.json</depends>
  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="VibeDesign" anchor="right" factoryClass="com.vibe.agent.design.DesignToolWindowFactory"
                icon="/icons/vibeDesign.svg" doNotActivateOnStart="true"/>
    <toolWindow id="VibeAudit" anchor="bottom" factoryClass="com.vibe.agent.audit.VibeAuditToolWindowFactory"
                icon="/icons/vibeAudit.svg" doNotActivateOnStart="true"/>
    <toolWindow id="VibeDocs" anchor="right" factoryClass="com.vibe.agent.docs.VibeDocsToolWindowFactory"
                icon="/icons/vibeDocs.svg" doNotActivateOnStart="true"/>
    <toolWindow id="VibeRuns" anchor="bottom" factoryClass="com.vibe.agent.runs.VibeRunsToolWindowFactory"
                icon="/icons/vibeRuns.svg" doNotActivateOnStart="true"/>
    <toolWindow id="VibeTasks" anchor="bottom"
                factoryClass="com.vibe.agent.background.VibeTasksToolWindowFactory"
                icon="/icons/vibeTasks.svg" doNotActivateOnStart="true"/>
    <toolWindow id="VibeAgent" anchor="right" factoryClass="com.vibe.agent.ui.VibeAgentToolWindowFactory" icon="/icons/vibeAgent.svg"/>
    <notificationGroup id="Vibe Agent" displayType="BALLOON"/>
    <!-- Блок версий в «О программе»: версия продукта, платформа, коммит — через точку расширения
         платформы, без патча диалога. -->
    <aboutPopupDescriptionProvider implementation="com.vibe.agent.product.VibeAboutPopupDescriptionProvider"/>
    <!-- Адреса продукта (метаданные обновлений, страница загрузки, баг-репорты) — наши, а не
         апстрима. Единственная точка расширения платформы для этого; патч платформы не нужен. -->
    <applicationService serviceInterface="com.intellij.platform.ide.customization.ExternalProductResourceUrls"
                        serviceImplementation="com.vibe.agent.product.VibeExternalProductResourceUrls"
                        overrides="true"/>
    <inline.completion.provider implementation="com.vibe.agent.fim.VibeFimProvider"/>
    <applicationConfigurable groupId="tools" displayName="VibeIDEA" id="com.vibe.settings" instance="com.vibe.agent.settings.VibeSettingsRoot"/>
    <projectConfigurable parentId="com.vibe.settings" displayName="Провайдеры" id="com.vibe.agent.providers" instance="com.vibe.agent.settings.VibeProvidersConfigurable"/>
    <projectConfigurable parentId="com.vibe.settings" displayName="Модели" id="com.vibe.agent.models" instance="com.vibe.agent.settings.VibeModelsConfigurable"/>
    <applicationConfigurable parentId="com.vibe.settings" displayName="Агент" id="com.vibe.agent.behavior" instance="com.vibe.agent.settings.VibeAgentConfigurable"/>
    <applicationConfigurable parentId="com.vibe.settings" displayName="Чат" id="com.vibe.agent.chat" instance="com.vibe.agent.settings.VibeChatConfigurable"/>
    <applicationConfigurable parentId="com.vibe.settings" displayName="Интерфейс" id="com.vibe.agent.ui" instance="com.vibe.agent.settings.VibeUiConfigurable"/>
    <!-- Толщину читает пропатченный JBScrollBar платформы (см. FORK_CHANGES.md): платформа не может
         зависеть от плагина, поэтому мостом служит Registry, а ключ объявляем здесь. -->
    <registryKey key="vibe.scrollbar.thickness" defaultValue="4" restartRequired="false"
                 description="Толщина скроллбаров VibeIDEA в пикселях (0 — штатные скроллы платформы)"/>
    <postStartupActivity implementation="com.vibe.agent.i18n.VibeLangSeeder"/>
    <postStartupActivity implementation="com.vibe.agent.history.VibeHistoryWarmUp"/>
    <postStartupActivity implementation="com.vibe.agent.guard.ConfigGuardStartup"/>
    <postStartupActivity implementation="com.vibe.agent.providers.LocalProbeStartup"/>
    <postStartupActivity implementation="com.vibe.agent.digest.DailyDigestStartup"/>
    <postStartupActivity implementation="com.vibe.agent.telegram.TelegramStartup"/>
    <postStartupActivity implementation="com.vibe.agent.settings.VibePromoDefaults"/>
    <postStartupActivity implementation="com.vibe.agent.defaults.VibeDefaultsSeeder"/>
    <postStartupActivity implementation="com.vibe.agent.providers.VibeProvidersWatcherStarter"/>
    <postStartupActivity implementation="com.vibe.agent.http.VibeHttpApiStarter"/>
    <statusBarWidgetFactory id="VibeAgentStatus" implementation="com.vibe.agent.ui.VibeAgentStatusWidgetFactory" order="last"/>
    <statusBarWidgetFactory id="VibeSpendStatus" implementation="com.vibe.agent.budget.VibeSpendStatusWidgetFactory" order="last"/>
  </extensions>
  <actions>
    <action id="Vibe.InlineEdit" class="com.vibe.agent.inline.VibeInlineEditAction"
            text="VibeIDEA: изменить выделенное" description="Правка выделенного кода моделью: /doc, /refactor, /tests, /explain, /fix">
      <keyboard-shortcut keymap="$default" first-keystroke="control K"/>
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
    </action>
    <action id="com.vibe.agent.exportCodeGraph" class="com.vibe.agent.graph.ExportCodeGraphAction" text="Vibe: экспорт графа проекта">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <group id="VibeIdea.History" text="VibeIDEA" popup="false">
      <action id="Vibe.FimMetrics" class="com.vibe.agent.fim.VibeFimMetricsAction"
              text="Метрики автодополнения" description="Попадания кэша, отказы, задержка модели p50/p95"/>
      <action id="Vibe.AddReferenceFolder" class="com.vibe.agent.context.VibeAddReferenceFolderAction"
              text="Добавить папку-справочник для агента (только чтение)"
              description="Материалы вне проекта: агент читает, но правит только проект"/>
      <action id="Vibe.ManageReferenceFolders" class="com.vibe.agent.context.VibeManageReferenceFoldersAction"
              text="Папки-справочники" description="Показать подключённые папки и отключить лишние"/>
      <action id="Vibe.DetectLocalModels" class="com.vibe.agent.providers.VibeDetectLocalModelsAction"
              text="Найти локальные модели" description="Проба привычных портов Ollama, LM Studio, llama.cpp, Jan"/>
      <action id="Vibe.PinnedCommand1" class="com.vibe.agent.commands.VibePinnedCommand1" text="Команда проекта 1">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift alt 1"/>
      </action>
      <action id="Vibe.PinnedCommand2" class="com.vibe.agent.commands.VibePinnedCommand2" text="Команда проекта 2">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift alt 2"/>
      </action>
      <action id="Vibe.PinnedCommand3" class="com.vibe.agent.commands.VibePinnedCommand3" text="Команда проекта 3">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift alt 3"/>
      </action>
      <action id="Vibe.PinnedCommand4" class="com.vibe.agent.commands.VibePinnedCommand4" text="Команда проекта 4">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift alt 4"/>
      </action>
      <action id="Vibe.PinnedCommand5" class="com.vibe.agent.commands.VibePinnedCommand5" text="Команда проекта 5">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift alt 5"/>
      </action>
      <action id="Vibe.PinnedCommand6" class="com.vibe.agent.commands.VibePinnedCommand6" text="Команда проекта 6">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift alt 6"/>
      </action>
      <action id="Vibe.PinnedCommand7" class="com.vibe.agent.commands.VibePinnedCommand7" text="Команда проекта 7">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift alt 7"/>
      </action>
      <action id="Vibe.PinnedCommand8" class="com.vibe.agent.commands.VibePinnedCommand8" text="Команда проекта 8">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift alt 8"/>
      </action>
      <action id="Vibe.PinnedCommand9" class="com.vibe.agent.commands.VibePinnedCommand9" text="Команда проекта 9">
        <keyboard-shortcut keymap="$default" first-keystroke="control shift alt 9"/>
      </action>
      <action id="Vibe.ProjectCommands" class="com.vibe.agent.commands.VibeProjectCommandsAction"
              text="Команды проекта" description="Команды из .vibe/commands.json: список, разрешение и запуск"/>
      <action id="Vibe.TelegramToken" class="com.vibe.agent.telegram.VibeTelegramTokenAction"
              text="Токен Telegram-бота" description="Мост в Telegram: свой бот, токен в защищённом хранилище"/>
      <action id="Vibe.UiKitMap" class="com.vibe.agent.design.VibeUiKitMapAction"
              text="Снять карту построенного" description="Токены, классы и компоненты проекта в .vibe/design/uiKit.md"/>
      <action id="Vibe.Doctor" class="com.vibe.agent.doctor.VibeDoctorAction"
              text="Диагностика" description="Один отчёт: сборка, провайдеры, конфиги, режимы, индексы"/>
      <action id="Vibe.DesignDoctor" class="com.vibe.agent.design.VibeDesignDoctorAction"
              text="Проверка дизайн-контура" description="Есть ли контекст, достижима ли страница, сколько правил, нет ли опечаток в отклонениях"/>
      <action id="Vibe.Specs" class="com.vibe.agent.specs.VibeSpecsAction"
              text="Спеки проекта" description="PRODUCT.md и TECH.md: что должно быть правдой и как это сделано"/>
      <action id="Vibe.DocsReport" class="com.vibe.agent.docs.VibeDocsReportAction"
              text="Связность документации" description="Недостижимые документы и ссылки в никуда"/>
      <action id="Vibe.DailyDigest" class="com.vibe.agent.digest.DailyDigestAction"
              text="Сводка за сутки" description="Что агенты сделали за последние сутки"/>
      <action id="Vibe.SpendExport" class="com.vibe.agent.budget.VibeExportSpendAction"
              text="VibeIDEA: выгрузить расход в CSV"
              description="Расход за месяц таблицей: время, чат, роль, цель, токены, стоимость, файлы"/>
      <action id="Vibe.SpendReport" class="com.vibe.agent.budget.VibeSpendReportAction"
              text="Расход по ролям" description="Куда ушли токены за сутки и за неделю"/>
      <action id="Vibe.ClearSpend" class="com.vibe.agent.budget.VibeClearSpendAction"
              text="Очистить учёт расхода" description="Стереть счётчики расхода"/>
      <action id="Vibe.SkillsCatalog" class="com.vibe.agent.skills.VibeSkillsCatalogAction"
              text="Навыки проекта" description="Состояние навыков относительно поставляемого набора и возврат к его версии"/>
      <action id="Vibe.ValidateSkills" class="com.vibe.agent.skills.VibeValidateSkillsAction"
              text="Проверить скиллы проекта" description="Валидация .vibe/skills/&lt;id&gt;/SKILL.md по контракту Agent Skills"/>
      <action id="Vibe.ShowApiToken" class="com.vibe.agent.http.VibeShowApiTokenAction"
              text="Показать токен HTTP API" description="Адрес и токен входящего HTTP API (только внутри IDE)"/>
      <action id="Vibe.RegenerateApiToken" class="com.vibe.agent.http.VibeRegenerateApiTokenAction"
              text="Перевыпустить токен HTTP API" description="Старый токен перестаёт работать немедленно"/>
      <action id="Vibe.ShowChatHistory" class="com.vibe.agent.history.VibeShowChatHistoryAction"
              text="История чата" description="Открыть выпадающий список прошлых чатов"/>
      <action id="Vibe.ExportProjectHistory" class="com.vibe.agent.history.VibeExportProjectHistoryAction"
              text="Экспортировать историю текущего проекта" description="Сохранить треды проекта в Markdown или JSON"/>
      <action id="Vibe.ClearProjectHistory" class="com.vibe.agent.history.VibeClearProjectHistoryAction"
              text="Удалить историю текущего проекта" description="Удалить все треды, принадлежащие этому проекту"/>
      <action id="Vibe.ClaimUntaggedHistory" class="com.vibe.agent.history.VibeClaimUntaggedHistoryAction"
              text="Привязать историю без проекта к текущему" description="Проставить тредам без проекта текущий проект"/>
      <action id="Vibe.AuditLog" class="com.vibe.agent.audit.VibeAuditLogAction"
              text="Журнал аудита агента" description="Показать последние записи .vibe/audit.jsonl, экспортировать или очистить"/>
      <action id="Vibe.Breakers" class="com.vibe.agent.gates.VibeBreakersAction"
              text="Предохранители агента" description="Показать и снять сработавшие защитные предохранители"/>
    </group>
  </actions>
</idea-plugin>
