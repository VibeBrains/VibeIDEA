<idea-plugin>
  <id>com.vibe.agent</id>
  <name>Vibe Agent</name>
  <vendor>VibeBrains</vendor>
  <description><![CDATA[
    Agent harness for VibeIDEA: a native Agent Client Protocol (ACP) client.
    Connects local coding agents (Claude Code via claude-agent-acp, Codex, Gemini CLI,
    goose and 60+ others from the ACP registry) to the IDE: streamed sessions,
    permission-gated tool calls, IDE-mapped file reads/writes.
    Compatible with the ~/.jetbrains/acp.json agent registry format.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="VibeAgent" anchor="right" factoryClass="com.vibe.agent.ui.VibeAgentToolWindowFactory" icon="/icons/vibeAgent.svg"/>
    <notificationGroup id="Vibe Agent" displayType="BALLOON"/>
    <inline.completion.provider implementation="com.vibe.agent.fim.VibeFimProvider"/>
    <applicationConfigurable groupId="tools" displayName="VibeIDEA" id="com.vibe.settings" instance="com.vibe.agent.settings.VibeSettingsRoot"/>
    <projectConfigurable parentId="com.vibe.settings" displayName="Провайдеры" id="com.vibe.agent.providers" instance="com.vibe.agent.settings.VibeProvidersConfigurable"/>
    <projectConfigurable parentId="com.vibe.settings" displayName="Модели" id="com.vibe.agent.models" instance="com.vibe.agent.settings.VibeModelsConfigurable"/>
    <applicationConfigurable parentId="com.vibe.settings" displayName="Чат" id="com.vibe.agent.chat" instance="com.vibe.agent.settings.VibeChatConfigurable"/>
    <postStartupActivity implementation="com.vibe.agent.history.VibeHistoryWarmUp"/>
  </extensions>
  <actions>
    <action id="com.vibe.agent.exportCodeGraph" class="com.vibe.agent.graph.ExportCodeGraphAction" text="Vibe: экспорт графа проекта">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
    <group id="VibeIdea.History" text="VibeIDEA" popup="false">
      <action id="Vibe.ShowChatHistory" class="com.vibe.agent.history.VibeShowChatHistoryAction"
              text="История чата" description="Открыть выпадающий список прошлых чатов"/>
      <action id="Vibe.ExportProjectHistory" class="com.vibe.agent.history.VibeExportProjectHistoryAction"
              text="Экспортировать историю текущего проекта" description="Сохранить треды проекта в Markdown или JSON"/>
      <action id="Vibe.ClearProjectHistory" class="com.vibe.agent.history.VibeClearProjectHistoryAction"
              text="Удалить историю текущего проекта" description="Удалить все треды, принадлежащие этому проекту"/>
      <action id="Vibe.ClaimUntaggedHistory" class="com.vibe.agent.history.VibeClaimUntaggedHistoryAction"
              text="Привязать историю без проекта к текущему" description="Проставить тредам без проекта текущий проект"/>
    </group>
  </actions>
</idea-plugin>
