{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Провайдеры моделей VibeIDEA (.vibe/providers.json)",
  "type": "object",
  "properties": {
    "providers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "protocol": {
            "type": "string",
            "enum": [
              "openai",
              "anthropic",
              "gemini"
            ]
          },
          "baseURL": {
            "type": "string",
            "description": "HTTPS наружу; http допустим только для localhost."
          },
          "extends": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "apiKeyEnv": {
            "type": "string",
            "description": "Имя переменной окружения. Значение ключа в файл не пишется."
          },
          "apiKeyRef": {
            "type": "string"
          },
          "reasoningDialect": {
            "type": "string",
            "enum": ["openrouter"],
            "description": "Как endpoint пишет рассуждение, если не так, как его протокол: openrouter — объект reasoning с effort, «выключено» — effort none."
          },
          "auth": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "bearer",
                  "header",
                  "query",
                  "none"
                ]
              },
              "name": {
                "type": "string"
              }
            }
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "query": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "models": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "vision": {
                  "type": "boolean"
                },
                "fim": {
                  "type": "boolean"
                },
                "temperature": {
                  "type": "number"
                },
                "topP": {
                  "type": "number"
                },
                "topK": {
                  "type": "integer"
                },
                "maxOutputTokens": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
