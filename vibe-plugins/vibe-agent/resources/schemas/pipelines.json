{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Пайплайны VibeIDEA (.vibe/pipelines.json)",
  "type": "object",
  "required": [
    "pipelines"
  ],
  "properties": {
    "pipelines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "role",
                "task"
              ],
              "properties": {
                "role": {
                  "type": "string",
                  "description": "Роль шага. Судящие роли (code-reviewer, critic, security, qa, explore, planner) не пишут файлы — только им можно задать свою модель.",
                  "enum": [
                    "explore",
                    "implement-step",
                    "recover-or-skip",
                    "orchestrator",
                    "planner",
                    "designer",
                    "frontend-dev",
                    "backend-dev",
                    "code-reviewer",
                    "critic",
                    "qa",
                    "security"
                  ]
                },
                "task": {
                  "type": "string"
                },
                "acceptance": {
                  "type": "string",
                  "description": "Критерий готовности шага."
                },
                "provider": {
                  "type": "string",
                  "description": "Провайдер из реестра: шаг пойдёт прямым запросом к модели, минуя ACP-агента. Задаётся только вместе с model и только для судящих ролей."
                },
                "model": {
                  "type": "string",
                  "description": "Модель этого шага. У такого шага нет инструментов и нет доступа к файлам."
                },
                "maxTokens": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Потолок токенов шага: превышение прекращает шаг. 0 или отсутствие — потолка нет. У шага на своей модели не действует."
                },
                "maxSteps": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Потолок вызовов инструментов шага: превышение прекращает шаг. 0 или отсутствие — потолка нет."
                },
                "escalation": {
                  "type": "boolean",
                  "description": "Шаг нужен, только если гейт pipelineStepEnd не принял предыдущий."
                },
                "continueOnFailure": {
                  "type": "boolean"
                },
                "ignorePreviousArtifacts": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
