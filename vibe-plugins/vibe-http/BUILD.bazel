load("@community//build:tests-options.bzl", "jps_test")
load("@rules_jvm//:jvm.bzl", "jvm_library")

jvm_library(
    name = "vibe-http",
    srcs = glob(
        [
            "src/**/*.kt",
            "src/**/*.java",
        ],
        allow_empty = True,
    ),
    module_name = "intellij.vibe.http",
    resource_strip_prefix = "resources",
    resources = glob(
        ["resources/**/*"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        # do not sort,
        "@lib//:kotlin-stdlib",
        "@lib//:kotlinx-serialization-json",
        "@lib//:kotlinx-serialization-core",
        "//platform/core-api:core",
        "//platform/core-impl",
        "//vibe-plugins/vibe-agent",
        "//platform/projectModel-api:projectModel",
        "//platform/util",
        "//platform/extensions",
        "//platform/platform-api:ide",
        "//platform/ide-core",
        "//platform/util:util-ui",
        "//platform/core-ui",
        "//platform/editor-ui-api:editor-ui",
        "//platform/analysis-api:analysis",
        "//platform/lang-api:lang",
        "//platform/lang-impl",
    ],
)

jvm_library(
    name = "vibe-http_test_lib",
    testonly = True,
    srcs = glob(
        ["testSrc/**/*.kt"],
        allow_empty = True,
    ),
    associates = [":vibe-http"],
    deps = [
        # do not sort,
        "@lib//:kotlin-stdlib",
        "@lib//:kotlin-test",
        "@lib//:kotlin-test-junit5",
        "//libraries/junit5",
        "//libraries/junit5:junit5_test_lib",
    ],
    visibility = ["//visibility:public"],
    runtime_deps = [
        # do not sort,
        ":vibe-http",
    ],
)

jps_test(
    name = "vibe-http_test",
    runtime_deps = [":vibe-http_test_lib"],
)

exports_files(
    [
        "intellij.vibe.http.iml",
        "resources/META-INF/plugin.xml",
    ],
    visibility = ["//visibility:public"],
)
