<idea-plugin>
  <id>com.vibe.http</id>
  <name>Vibe HTTP Client</name>
  <vendor>VibeBrains</vendor>
  <description><![CDATA[
    HTTP requests next to the code: .http files in the repository, environments in
    http-client.env.json, responses shown in the IDE. Requests are files, so they go through
    code review and version control like everything else.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <!-- Каталог строк общий для всех наших плагинов (решение владельца 2026-08-30). -->
  <depends>com.vibe.agent</depends>

  <extensions defaultExtensionNs="com.intellij">
    <fileType name="VibeHttpRequest" implementationClass="com.vibe.http.HttpFileType" fieldName="INSTANCE"
              language="VibeHttp" extensions="http;rest"/>
    <lang.parserDefinition language="VibeHttp" implementationClass="com.vibe.http.HttpParserDefinition"/>
    <lang.syntaxHighlighterFactory language="VibeHttp" implementationClass="com.vibe.http.HttpSyntaxHighlighterFactory"/>
    <codeInsight.lineMarkerProvider language="VibeHttp" implementationClass="com.vibe.http.ui.HttpRunLineMarker"/>
    <toolWindow id="HTTP" anchor="right" icon="/icons/vibeHttp.svg"
                factoryClass="com.vibe.http.ui.VibeHttpToolWindowFactory" doNotActivateOnStart="true"/>
    <applicationConfigurable parentId="com.vibe.settings" displayName="HTTP-клиент" id="com.vibe.http.settings"
                             instance="com.vibe.http.ui.VibeHttpConfigurable"/>
    <notificationGroup id="Vibe HTTP" displayType="BALLOON"/>
  </extensions>

  <actions>
    <action id="Vibe.Http.ImportCurl" class="com.vibe.http.ui.VibeHttpImportCurlAction" icon="AllIcons.Actions.Download">
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
    </action>
    <action id="Vibe.Http.Run" class="com.vibe.http.ui.VibeHttpRunAction" icon="AllIcons.Actions.Execute">
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control alt ENTER"/>
    </action>
  </actions>
</idea-plugin>
