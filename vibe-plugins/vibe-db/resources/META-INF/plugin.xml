<idea-plugin>
  <id>com.vibe.db</id>
  <name>Vibe Database</name>
  <vendor>VibeBrains</vendor>
  <description><![CDATA[
    Databases next to the code: connections described in .vibe/dataSources.json, an object tree,
    a SQL console and a result table. Passwords never live in the file — they go to the system
    keychain.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <!-- Каталог строк общий для всех наших плагинов (решение владельца 2026-08-30). -->
  <depends>com.vibe.agent</depends>

  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="VibeDb" anchor="right" icon="/icons/vibeDb.svg"
                factoryClass="com.vibe.db.ui.VibeDbToolWindowFactory" doNotActivateOnStart="true"/>
    <applicationConfigurable parentId="com.vibe.settings" displayName="Базы данных" id="com.vibe.db.settings"
                             instance="com.vibe.db.ui.VibeDbConfigurable"/>
    <notificationGroup id="Vibe Database" displayType="BALLOON"/>
  </extensions>

  <actions>
    <action id="Vibe.Db.RunSql" class="com.vibe.db.ui.VibeDbRunSqlAction" icon="AllIcons.Actions.Execute">
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
      <keyboard-shortcut keymap="$default" first-keystroke="control alt ENTER"/>
    </action>
  </actions>
</idea-plugin>
