# Закреплённые версии внешних артефактов дистрибутива — ОДИН источник правды.
#
# Файл читают все: download.sh (macOS/Linux), download.ps1 (Windows), гейт аудита и гейт
# дистрибутива. Пока версии жили в теле sh-скрипта, второй скрипт для Windows означал бы вторую
# копию тех же чисел — а копия версии расходится не «если», а «когда», и расходится молча: обе
# сборки успешны, содержимое разное.
#
# Формат намеренно тупой — KEY=value, без кавычек и пробелов: его читает и `source` в sh, и
# трёхстрочный разбор в PowerShell, и `grep` в гейтах.

# LSP4IJ — клиент LSP/DAP (EPL-2.0), ставится готовым плагином.
LSP4IJ_V=0.20.1
LSP4IJ_SHA=3d2bffc78df998aebdbefc4714f351353b22762ec5d383eb33591acb54d3e419

# Phpactor — языковой сервер PHP (MIT), один самодостаточный phar на машинном PHP.
