<idea-plugin>
  <id>com.vibe.lsp</id>
  <name>Vibe Languages: TypeScript, PHP, CSS, ESLint</name>
  <vendor>VibeBrains</vendor>
  <description><![CDATA[
    First-class TypeScript and PHP support for VibeIDEA through the Language Server Protocol:
    vtsls (TypeScript, MIT), Phpactor (PHP, MIT), the VS Code CSS server and ESLint (both MIT,
    from vscode-langservers-extracted) wired into the bundled LSP4IJ client. HTML and JSON are left
    to the platform, which serves them natively.
    Syntax highlighting comes from the bundled TextMate grammars — including Vue, Svelte, Astro,
    Sass and Stylus, which the open platform does not know at all.
  ]]></description>
  <depends>com.intellij.modules.platform</depends>
  <!-- Каталог строк общий для всех наших плагинов (решение владельца 2026-08-30). -->
  <depends>com.vibe.agent</depends>
  <depends optional="true" config-file="vibe-lsp4ij-integration.xml">com.redhat.devtools.lsp4ij</depends>
  <depends optional="true" config-file="vibe-textmate-bundles.xml">org.jetbrains.plugins.textmate</depends>

  <!-- Инструмент «что умеет эта IDE» спрашивает каждую область у её владельца: про серверы
       рассказываем мы, а не vibe-agent, который о них не знает. -->
  <extensions defaultExtensionNs="com.vibe.agent">
    <ideFacts implementation="com.vibe.lsp.LspIdeFacts"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <notificationGroup id="Vibe Languages" displayType="BALLOON"/>
    <!-- Под общим корнем настроек VibeIDEA, который объявляет vibe-agent. -->
    <applicationConfigurable parentId="com.vibe.settings" displayName="Языковые серверы"
                             id="com.vibe.lsp.paths" instance="com.vibe.lsp.VibeLspConfigurable"/>
    <postStartupActivity implementation="com.vibe.lsp.VibeLspSuggestionSilencer"/>
    <!-- Ext JS: переход по имени класса и по пути в строке. JS-ядра в открытой платформе нет,
         поэтому и индекс, и переход считают по тексту файла. -->
    <fileBasedIndex implementation="com.vibe.lsp.extjs.ExtDefineIndexExtension"/>
    <fileBasedIndex implementation="com.vibe.lsp.extjs.ExtClassIndexExtension"/>
    <fileBasedIndex implementation="com.vibe.lsp.extjs.ExtMemberIndexExtension"/>
    <fileBasedIndex implementation="com.vibe.lsp.extjs.ExtEventIndexExtension"/>
    <gotoDeclarationHandler implementation="com.vibe.lsp.extjs.ExtGotoDeclarationHandler"/>
    <!-- The switch of our own go-to (PreciseNavigation); the handler itself is registered with LSP4IJ's
         integration, since it talks to the servers through LSP4IJ. -->
    <registryKey key="vibe.lsp.precise.navigation" defaultValue="true"
                 description="VibeIDEA: свой переход по коду вместо перехода LSP4IJ — ждёт сервер с потолком и помнит ответы по позиции; выключите, чтобы вернуть переход LSP4IJ"/>
  </extensions>

  <projectListeners>
    <listener class="com.vibe.lsp.VibeLspMissingServerNotifier"
              topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    <listener class="com.vibe.lsp.VibeJsConfigNotifier"
              topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    <!-- Смена ветки меняет файлы под запущенным сервером: его модель проекта надо пересобрать. -->
    <listener class="com.vibe.lsp.VibeBranchListener"
              topic="com.intellij.openapi.vcs.BranchChangeListener"/>
  </projectListeners>

  <actions>
    <action id="Vibe.LspDoctor" class="com.vibe.lsp.VibeLspDoctorAction"
            text="VibeIDEA: языковые серверы"
            description="Какие языковые серверы установлены и как поставить недостающие">
      <add-to-group group-id="ToolsMenu" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
