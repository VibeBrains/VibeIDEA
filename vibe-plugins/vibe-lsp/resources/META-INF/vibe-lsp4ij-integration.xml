<idea-plugin>
  <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
    <server id="vibeVtsls" name="TypeScript (vtsls)" factoryClass="com.vibe.lsp.VtslsServerFactory">
      <description>TypeScript/JavaScript language server (vtsls, wraps the VSCode TS extension)</description>
    </server>
    <!-- languageId РЕШАЕТ, как tsserver разбирает файл: под «typescript» синтаксис JSX запрещён,
         и каждый тег .tsx превращается в ошибку «'>' expected» — сотня ошибок в здоровом файле.
         Поэтому шаблоны разведены по четырём идентификаторам, как это делает VS Code. -->
    <fileNamePatternMapping patterns="*.ts;*.mts;*.cts" serverId="vibeVtsls" languageId="typescript"/>
    <fileNamePatternMapping patterns="*.tsx" serverId="vibeVtsls" languageId="typescriptreact"/>
    <fileNamePatternMapping patterns="*.js;*.mjs;*.cjs" serverId="vibeVtsls" languageId="javascript"/>
    <fileNamePatternMapping patterns="*.jsx" serverId="vibeVtsls" languageId="javascriptreact"/>
    <!-- Angular: официальный сервер самого Angular (MIT). Работает рядом с vtsls на .ts — он
         отвечает про шаблоны и Angular-сущности, vtsls про язык; так же устроен VS Code.
         На .html он единственный, кто вообще понимает Angular-шаблон: платформенный HTML знает
         теги браузера и про компоненты не слышал. -->
    <server id="vibeAngular" name="Angular" factoryClass="com.vibe.lsp.AngularServerFactory">
      <description>Angular language server: templates, components, directives and pipes</description>
    </server>
    <fileNamePatternMapping patterns="*.html" serverId="vibeAngular" languageId="html"/>
    <fileNamePatternMapping patterns="*.ts" serverId="vibeAngular" languageId="typescript"/>

    <!-- Один вход на *.php: движок (Phpactor или Intelephense) выбирается в настройках, а два
         зарегистрированных сервера на одном шаблоне запустились бы оба и удвоили подсказки. -->
    <server id="vibePhp" name="PHP" factoryClass="com.vibe.lsp.PhpServerFactory">
      <description>PHP language server: Phpactor or Intelephense, whichever the settings choose</description>
    </server>
    <fileNamePatternMapping patterns="*.php" serverId="vibePhp" languageId="php"/>
    <!-- CSS и LESS: фронтовые языки, которых в Community нет вовсе.
         HTML и JSON тем же пакетом НЕ подключаем — платформа обслуживает их сама.
         SCSS и Sass ушли к Some Sass 18.09.2026: он ходит между файлами, этот нет. -->
    <server id="vibeCss" name="CSS/LESS" factoryClass="com.vibe.lsp.CssServerFactory">
      <description>CSS and LESS language server (vscode-langservers-extracted)</description>
    </server>
    <fileNamePatternMapping patterns="*.css" serverId="vibeCss" languageId="css"/>
    <fileNamePatternMapping patterns="*.less" serverId="vibeCss" languageId="less"/>
    <!-- Диалекты PostCSS: это тот же CSS, только с плагинами, — отдельного сервера у них нет, а
         без сопоставления файл не обслуживал никто. -->
    <fileNamePatternMapping patterns="*.pcss;*.postcss;*.sss" serverId="vibeCss" languageId="css"/>

    <!-- Stylus: третий диалект CSS. Стартует только на .styl, поэтому условий включения не нужно. -->
    <server id="vibeStylus" name="Stylus" factoryClass="com.vibe.lsp.StylusServerFactory">
      <description>Stylus language server (tree-sitter based)</description>
    </server>
    <fileNamePatternMapping patterns="*.styl" serverId="vibeStylus" languageId="stylus"/>

    <!-- SCSS и Sass: переход к переменной и миксину ЧЕРЕЗ файлы, чего общий CSS-сервер не умеет.
         `.sass` с отступами до сих пор не обслуживал никто. -->
    <server id="vibeSomeSass" name="SCSS/Sass" factoryClass="com.vibe.lsp.SomeSassServerFactory">
      <description>SCSS and Sass language server with cross-file navigation (Some Sass)</description>
    </server>
    <fileNamePatternMapping patterns="*.scss" serverId="vibeSomeSass" languageId="scss"/>
    <fileNamePatternMapping patterns="*.sass" serverId="vibeSomeSass" languageId="sass"/>

    <!-- Tailwind: подсказка классов в разметке и объяснение `@apply`. Поднимается только там, где
         проект действительно на Tailwind, — решает фабрика через свои LSPClientFeatures. -->
    <server id="vibeTailwind" name="Tailwind CSS" factoryClass="com.vibe.lsp.TailwindServerFactory">
      <description>Tailwind CSS language server: class completion, colours and @apply</description>
    </server>
    <fileNamePatternMapping patterns="*.html" serverId="vibeTailwind" languageId="html"/>
    <fileNamePatternMapping patterns="*.css;*.scss;*.sass" serverId="vibeTailwind" languageId="css"/>
    <fileNamePatternMapping patterns="*.jsx" serverId="vibeTailwind" languageId="javascriptreact"/>
    <fileNamePatternMapping patterns="*.tsx" serverId="vibeTailwind" languageId="typescriptreact"/>
    <fileNamePatternMapping patterns="*.vue" serverId="vibeTailwind" languageId="vue"/>
    <fileNamePatternMapping patterns="*.svelte" serverId="vibeTailwind" languageId="svelte"/>
    <server id="vibeEslint" name="ESLint" factoryClass="com.vibe.lsp.EslintServerFactory">
      <description>ESLint language server: the project's own rules in the editor</description>
    </server>
    <!-- Та же причина, что у vtsls: ESLint выбирает парсер по languageId, и «javascript» на .tsx
         означает разбор TSX парсером JavaScript. -->
    <fileNamePatternMapping patterns="*.js;*.mjs;*.cjs" serverId="vibeEslint" languageId="javascript"/>
    <fileNamePatternMapping patterns="*.jsx" serverId="vibeEslint" languageId="javascriptreact"/>
    <fileNamePatternMapping patterns="*.ts" serverId="vibeEslint" languageId="typescript"/>
    <fileNamePatternMapping patterns="*.tsx" serverId="vibeEslint" languageId="typescriptreact"/>
    <fileNamePatternMapping patterns="*.vue" serverId="vibeEslint" languageId="vue"/>
    <fileNamePatternMapping patterns="*.svelte" serverId="vibeEslint" languageId="svelte"/>

    <!-- Отладчики. Точка расширения помечена у LSP4IJ как экспериментальная: две тонкие фабрики —
         осознанная цена за «отладка одним действием» вместо JSON руками. -->
    <debugAdapterServer id="vibeJsDebug" name="JavaScript/TypeScript (vscode-js-debug)"
                        factoryClass="com.vibe.lsp.dap.JsDebugAdapterFactory">
      <description>Debug adapter for JavaScript and TypeScript (vscode-js-debug, MIT)</description>
    </debugAdapterServer>
    <debugAdapterServer id="vibePhpDebug" name="PHP (Xdebug)"
                        factoryClass="com.vibe.lsp.dap.PhpDebugAdapterFactory">
      <description>Debug adapter for PHP over Xdebug (vscode-php-debug, MIT)</description>
    </debugAdapterServer>
  </extensions>
</idea-plugin>
