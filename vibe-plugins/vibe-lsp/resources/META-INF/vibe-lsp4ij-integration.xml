<idea-plugin>
  <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
    <server id="vibeVtsls" name="TypeScript (vtsls)" factoryClass="com.vibe.lsp.VtslsServerFactory">
      <description>TypeScript/JavaScript language server (vtsls, wraps the VSCode TS extension)</description>
    </server>
    <fileNamePatternMapping patterns="*.ts;*.tsx;*.mts;*.cts;*.js;*.jsx;*.mjs;*.cjs" serverId="vibeVtsls" languageId="typescript"/>
    <server id="vibePhpactor" name="PHP (Phpactor)" factoryClass="com.vibe.lsp.PhpactorServerFactory">
      <description>PHP language server (Phpactor)</description>
    </server>
    <fileNamePatternMapping patterns="*.php" serverId="vibePhpactor" languageId="php"/>
    <!-- CSS/SCSS/LESS: единственный фронтовый язык, которого в Community нет вовсе.
         HTML и JSON тем же пакетом НЕ подключаем — платформа обслуживает их сама. -->
    <server id="vibeCss" name="CSS/SCSS/LESS" factoryClass="com.vibe.lsp.CssServerFactory">
      <description>CSS, SCSS and LESS language server (vscode-langservers-extracted)</description>
    </server>
    <fileNamePatternMapping patterns="*.css;*.scss;*.less" serverId="vibeCss" languageId="css"/>
    <server id="vibeEslint" name="ESLint" factoryClass="com.vibe.lsp.EslintServerFactory">
      <description>ESLint language server: the project's own rules in the editor</description>
    </server>
    <fileNamePatternMapping patterns="*.ts;*.tsx;*.js;*.jsx;*.mjs;*.cjs;*.vue;*.svelte" serverId="vibeEslint" languageId="javascript"/>

    <!-- Отладчики. Точка расширения помечена у LSP4IJ как экспериментальная: две тонкие фабрики —
         осознанная цена за «отладка одним действием» вместо JSON руками. -->
    <debugAdapterServer id="vibeJsDebug" name="JavaScript/TypeScript (vscode-js-debug)"
                        factoryClass="com.vibe.lsp.dap.JsDebugAdapterFactory">
      <description>Debug adapter for JavaScript and TypeScript (vscode-js-debug, MIT)</description>
    </debugAdapterServer>
    <debugAdapterServer id="vibePhpDebug" name="PHP (Xdebug)"
                        factoryClass="com.vibe.lsp.dap.PhpDebugAdapterFactory">
      <description>Debug adapter for PHP over Xdebug (vscode-php-debug, MIT)</description>
    </debugAdapterServer>
  </extensions>
</idea-plugin>
