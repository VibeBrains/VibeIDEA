load("@community//build:tests-options.bzl", "jps_test")
load("@rules_jvm//:jvm.bzl", "jvm_library")

jvm_library(
    name = "vibe-lsp",
    srcs = glob(
        [
            "src/**/*.kt",
            "src/**/*.java",
        ],
        allow_empty = True,
    ),
    module_name = "intellij.vibe.lsp",
    resource_strip_prefix = "resources",
    resources = glob(
        ["resources/**/*"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        # do not sort,
        "@lib//:kotlin-stdlib",
        "//platform/core-api:core",
        "//platform/core-impl",
        "//platform/projectModel-api:projectModel",
        "//platform/util",
        "//platform/extensions",
        "//platform/platform-api:ide",
        "//platform/ide-core",
        "//platform/editor-ui-api:editor-ui",
        "//platform/core-ui",
        "//platform/util:util-ui",
        "//platform/analysis-api:analysis",
        "//vibe-plugins/vibe-agent",
        "@lib//vibe/lsp4ij:vibe-lsp4ij",
    ],
)

jvm_library(
    name = "vibe-lsp_test_lib",
    testonly = True,
    srcs = glob(
        ["testSrc/**/*.kt"],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
    associates = [":vibe-lsp"],
    deps = [
        # do not sort,
        "@lib//:kotlin-stdlib",
        "@lib//:kotlin-test",
        "@lib//:kotlin-test-junit5",
        "//libraries/junit5",
        "//libraries/junit5:junit5_test_lib",
        # The factories implement an LSP4IJ interface, so the test engine cannot even scan the
        # module without LSP4IJ and the lsp4j it is built on.
        "@lib//vibe/lsp4ij:vibe-lsp4ij",
        "//libraries/lsp4j",
    ],
    runtime_deps = [
        # do not sort,
        ":vibe-lsp",
    ],
)

jps_test(
    name = "vibe-lsp_test",
    runtime_deps = [":vibe-lsp_test_lib"],
)

exports_files(
    [
        "intellij.vibe.lsp.iml",
        "resources/META-INF/plugin.xml",
    ],
    visibility = ["//visibility:public"],
)
