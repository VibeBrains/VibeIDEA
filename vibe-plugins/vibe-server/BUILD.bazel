load("@rules_jvm//:jvm.bzl", "jvm_library")

jvm_library(
    name = "vibe-server",
    srcs = glob(
        [
            "src/**/*.kt",
            "src/**/*.java",
        ],
        allow_empty = True,
    ),
    module_name = "intellij.vibe.server",
    resource_strip_prefix = "resources",
    resources = glob(
        ["resources/**/*"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        # do not sort,
        "@lib//:kotlin-stdlib",
        "@lib//:kotlinx-serialization-json",
        "@lib//:kotlinx-serialization-core",
        "//platform/core-api:core",
        "//vibe-plugins/vibe-agent",
        "//platform/projectModel-api:projectModel",
        "//platform/util",
        "//platform/extensions",
        "//platform/platform-api:ide",
        "//platform/ide-core",
        "//platform/util:util-ui",
        "//platform/core-ui",
    ],
)

jvm_library(
    name = "vibe-server_test_lib",
    testonly = True,
    srcs = glob(
        [],
        allow_empty = True,
    ),
    module_name = "intellij.vibe.server",
    visibility = ["//visibility:public"],
    runtime_deps = [
        # do not sort,
        ":vibe-server",
    ],
)

exports_files(
    [
        "intellij.vibe.server.iml",
        "resources/META-INF/plugin.xml",
    ],
    visibility = ["//visibility:public"],
)
