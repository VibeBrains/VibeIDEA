load("@rules_jvm//:jvm.bzl", "jvm_library")

jvm_library(
    name = "vibe-theme",
    srcs = glob(
        [],
        allow_empty = True,
    ),
    module_name = "intellij.vibe.theme",
    resource_strip_prefix = "resources",
    resources = glob(
        ["resources/**/*"],
    ),
    visibility = ["//visibility:public"],
)

jvm_library(
    name = "vibe-theme_test_lib",
    testonly = True,
    srcs = glob(
        [],
        allow_empty = True,
    ),
    module_name = "intellij.vibe.theme",
    visibility = ["//visibility:public"],
    runtime_deps = [
        # do not sort,
        ":vibe-theme",
    ],
)

exports_files(
    [
        "intellij.vibe.theme.iml",
        "resources/META-INF/plugin.xml",
    ],
    visibility = ["//visibility:public"],
)
