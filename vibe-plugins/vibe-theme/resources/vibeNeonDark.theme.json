{
  "name": "Vibe Neon Dark",
  "dark": true,
  "author": "VibeBrains",
  "parentTheme": "Dark",
  "editorScheme": "/vibeNeonScheme.xml",
  "colors": {
    "NeonCyan": "#00E5FF",
    "NeonCyanDim": "#00B8CC",
    "NeonMagenta": "#FF2E97",
    "NeonPurple": "#9D5CFF",
    "DeepBg": "#16171B",
    "PanelBg": "#1E1F24",
    "SelBg": "#28324A"
  },
  "ui": {
    "*": {
      "focusColor": "NeonCyan",
      "underlineColor": "NeonCyan",
      "inactiveUnderlineColor": "NeonCyanDim",
      "selectionBackground": "SelBg"
    },
    "Component": {
      "focusedBorderColor": "NeonCyan",
      "arc": 8
    },
    "Button": {
      "default": {
        "startBackground": "#2A3550",
        "endBackground": "#2A3550",
        "startBorderColor": "NeonCyan",
        "endBorderColor": "NeonCyan",
        "foreground": "#E8FBFF"
      }
    },
    "Link": {
      "activeForeground": "NeonCyan",
      "hoverForeground": "NeonCyan",
      "pressedForeground": "NeonMagenta",
      "visitedForeground": "NeonPurple"
    },
    "EditorTabs": {
      "underlineHeight": 3,
      "underlineArc": 3
    },
    "ProgressBar": {
      "progressColor": "NeonCyan",
      "indeterminateStartColor": "NeonCyan",
      "indeterminateEndColor": "NeonMagenta"
    },
    "SearchMatch": {
      "startBackground": "#3C2B4F",
      "endBackground": "#3C2B4F"
    },
    "ToolWindow": {
      "Button": {
        "selectedBackground": "#2A3550"
      }
    },
    "TabbedPane": {
      "focusColor": "NeonCyan",
      "hoverColor": "#252A38"
    },
    "StatusBar": {
      "Widget": {
        "hoverBackground": "#252A38"
      }
    },
    "Counter": {
      "background": "NeonMagenta"
    },
    "Vibe": {
      "Chat": {
        "background": "DeepBg",
        "userBubbleBackground": "SelBg",
        "toolCardBackground": "PanelBg",
        "metaForeground": "NeonCyanDim",
        "terminalBackground": "#131417",
        "terminalForeground": "#BFC7D0",
        "terminalBorder": "#2A2D36",
        "terminalOk": "#5FAD5F",
        "terminalError": "#FF6B5A"
      },
      "Composer": {
        "background": "PanelBg",
        "border": "#2A2D36",
        "focusBorder": "NeonCyanDim",
        "separator": "#2A2D36",
        "chipBackground": "SelBg",
        "chipForeground": "#E6E8EF",
        "pillForeground": "#E6E8EF",
        "pillHoverBackground": "#252A38",
        "accent": "NeonCyan",
        "accentHover": "#33ECFF",
        "accentForeground": "DeepBg",
        "accentDisabled": "#3A4A52",
        "queueBackground": "#3A3220",
        "queueBorder": "#6B5A2E",
        "queueForeground": "#F2E6C4",
        "usageForeground": "NeonCyanDim",
        "usageWarnForeground": "#E0A030"
      },
      "Mention": {
        "headerForeground": "#E6E8EF",
        "hintForeground": "NeonCyanDim"
      },
      "Tabs": {
        "activeForeground": "#E6E8EF",
        "inactiveForeground": "NeonCyanDim",
        "activeBackground": "#252A38",
        "hoverBackground": "#20242E",
        "underline": "NeonCyan"
      },
      "History": {
        "rowHoverBackground": "#252A38",
        "activeStripe": "NeonMagenta",
        "badgeBackground": "SelBg",
        "quoteForeground": "NeonCyanDim",
        "groupForeground": "NeonCyanDim",
        "revealBackground": "SelBg"
      }
    }
  }
}
